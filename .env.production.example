# ==========================================
# WorkPulse HRIS - Production Environment Template
# ==========================================

# 1. Database Connection (SQLite in container)
DATABASE_URL="file:/app/prisma/dev.db"

# 2. Security & Token Secrets (Generate high-entropy 64-char strings)
# e.g., run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace_with_a_super_strong_production_jwt_secret_64_characters"
JWT_EXPIRES_IN="7d"

# 3. Data-at-Rest Field Encryption Key (64-character hex string for AES-256-GCM)
DATA_ENCRYPTION_KEY="replace_with_a_64_char_hex_encryption_key_for_pii_data"

# 4. Networking & CORS Policy
PORT=4000
NODE_ENV=production

# Comma-separated list of allowed domains for web access (or * for open access)
ALLOWED_ORIGINS="https://workpulse.yourcompany.com,https://hris.yourcompany.com"

# 5. Mobile & Public API Configuration
NEXT_PUBLIC_API_URL="https://workpulse.yourcompany.com"
